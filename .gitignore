# Car-Star — root ignore rules (applies to the whole repository)

# ─── Dependencies ───────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ─── Next.js ────────────────────────────────────────────────────────────────
.next/
out/

# ─── Build / compile output ─────────────────────────────────────────────────
build/
dist/
*.tsbuildinfo

# ─── Environment & secrets (keep .env.example tracked) ─────────────────────
.env
.env.*
!.env.example

# ─── Testing ────────────────────────────────────────────────────────────────
coverage/

# ─── Package manager & tool logs ────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─── Cursor / local IDE session artifacts ───────────────────────────────────
.cursor

# ─── Vercel ─────────────────────────────────────────────────────────────────
.vercel

# ─── Turbo (if used later) ──────────────────────────────────────────────────
.turbo

# ─── ESLint ─────────────────────────────────────────────────────────────────
.eslintcache

# ─── OS & editors ───────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
*.swp
*.swo
*~

# ─── Certificates / keys (local) ────────────────────────────────────────────
*.pem
