// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Configuration {
  id        String   @id @default(cuid())
  token     String   @unique
  data      Json     // full configuration as JSON
  createdAt DateTime @default(now())
  userEmail String?
  userName  String?
  userPhone String?
  images    ConfigurationImage[]
}

/// Quote pictures of a configuration (the 3D renders made in the customer's browser), one per view.
/// Accessed only through src/app/api/_lib/renderStore.ts, so the bytes can move to disk or S3 later.
model ConfigurationImage {
  id              String        @id @default(cuid())
  configurationId String
  configuration   Configuration @relation(fields: [configurationId], references: [id], onDelete: Cascade)
  view            String        // front | rear | side | aerial (RENDER_VIEWS)
  mime            String        // always image/jpeg (checked by magic bytes)
  bytes           Bytes
  width           Int
  height          Int
  createdAt       DateTime      @default(now())

  @@unique([configurationId, view])
}

model Prices {
  id              String   @id @default(cuid())
  structurePerM3  Float
  foundationPerM2 Float
  sandwichPerM2   Float
  windowPerUnit   Float
  doorPerUnit     Float
  bigDoorPerUnit  Float
  updatedAt       DateTime @updatedAt
}

/// Colours the admin offers per hall component (see src/lib/colors.ts). Seeded with DEFAULT_PALETTE on first use.
model ColorOption {
  id         String  @id
  component  String  // walls | roof | steel | trims | doors | windows
  name       String
  ral        String  @default("")
  hex        String  // #rrggbb
  surcharge  Float   @default(0)
  isDefault  Boolean @default(false)
  sortOrder  Int     @default(0)

  @@index([component])
}

/// Predefined halls the admin offers as starting points ("modele"). `data` is a hall configuration
/// (see hallModelDataSchema in src/lib/validation/models.ts); `thumbnail` is a data: URL captured from the 3D view.
model HallModel {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  data        Json
  thumbnail   String   @default("")
  published   Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Small admin settings stored as JSON under a fixed key, e.g. "uiTheme" (src/app/api/_lib/settings.ts).
/// One row per key; validated on write and normalised on read, so an old or partial value never breaks a page.
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
