# Copy to .env and adjust. See README.md.

# ─── Database (SQLite, path relative to the project root) ──
DATABASE_URL="file:./prisma/dev.db"

# ─── Resend (email) ────────────────────────────────────────
RESEND_API_KEY="re_your_api_key_here"
RESEND_FROM_EMAIL="noreply@yourdomain.com"
RESEND_TO_EMAIL="contact@yourdomain.com"

# ─── Dev server: extra hosts allowed to load /_next dev assets (comma separated, e.g. an ngrok host) ──
# ALLOWED_DEV_ORIGINS="my-tunnel.ngrok-free.dev"

# ─── Admin auth (HMAC-signed session cookie) ───────────────
# At least 32 random chars, e.g. `openssl rand -base64 48`
AUTH_SECRET="replace-with-at-least-32-random-characters"
ADMIN_USERNAME="admin"
# bcrypt hash. In .env every $ must be escaped as \$ (Next expands $VAR). Generate with:
#   node -e "console.log(require('bcryptjs').hashSync(process.argv[1],12))" '<password>'
# then replace each $ in the output with \$
ADMIN_PASSWORD_HASH=\$2b\$12\$replace-with-your-bcrypt-hash

# ─── Public base URL (used to validate links in contact emails) ──
APP_BASE_URL="https://your-domain"
