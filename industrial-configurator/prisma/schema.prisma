// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Configuration {
  id        String   @id @default(cuid())
  token     String   @unique
  data      Json     // full configuration as JSON
  createdAt DateTime @default(now())
  userEmail String?
  userName  String?
  userPhone String?
}

model Prices {
  id              String   @id @default(cuid())
  structurePerM3  Float
  foundationPerM2 Float
  sandwichPerM2   Float
  windowPerUnit   Float
  doorPerUnit     Float
  bigDoorPerUnit  Float
  updatedAt       DateTime @updatedAt
}

/// Colours the admin offers per hall component (see src/lib/colors.ts). Seeded with DEFAULT_PALETTE on first use.
model ColorOption {
  id         String  @id
  component  String  // walls | roof | steel | trims | doors | windows
  name       String
  ral        String  @default("")
  hex        String  // #rrggbb
  surcharge  Float   @default(0)
  isDefault  Boolean @default(false)
  sortOrder  Int     @default(0)

  @@index([component])
}
